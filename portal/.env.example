# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; never expose to the browser

# Public URL of the deployed portal (used in invite / reset-password emails)
NEXT_PUBLIC_SITE_URL=https://portal.trumbullnorth.com

# The one admin account. Must match public.is_admin() in supabase/schema.sql.
ADMIN_EMAIL=kevin@akcapital.fund

# Strongly recommended: transactional email via https://resend.com (free tier
# is fine). When set, invites and password resets are sent through Resend
# instead of Supabase's built-in mailer (which only allows a few emails/hour),
# plus subscription alerts to you and confirmations to investors. Without it,
# auth emails depend on Supabase's rate-limited mailer.
# NOTE: the default onboarding@resend.dev sender only delivers to your own
# Resend account email — verify your domain and use e.g. portal@trumbullnorth.com.
RESEND_API_KEY=
EMAIL_FROM="3331 Trumbull Portal <onboarding@resend.dev>"
