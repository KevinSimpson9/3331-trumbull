# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; never expose to the browser

# Public URL of the deployed portal (used in invite / reset-password emails)
NEXT_PUBLIC_SITE_URL=https://portal.trumbullnorth.com

# The one admin account. Must match public.is_admin() in supabase/schema.sql.
ADMIN_EMAIL=kevin@akcapital.fund

# Strongly recommended: transactional email via https://resend.com (free tier
# is fine). With it, the portal sends invite emails itself with reliable
# first-try set-password links (no Supabase email rate limit). Without it,
# invites fall back to Supabase's auth emails — make sure the email templates
# are updated per the README so those links work too.
RESEND_API_KEY=
# EMAIL_FROM must use a domain you've verified in Resend (e.g.
# "3331 Trumbull Portal <invites@trumbullnorth.com>"). The default
# onboarding@resend.dev sender can ONLY deliver to your own Resend account
# email — sends to investors will fail until a verified domain is set.
EMAIL_FROM="3331 Trumbull Portal <onboarding@resend.dev>"
