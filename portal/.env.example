# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; never expose to the browser

# Public URL of the deployed portal (used in invite / reset-password emails)
NEXT_PUBLIC_SITE_URL=https://portal.trumbullnorth.com

# The one admin account. Must match public.is_admin() in supabase/schema.sql.
ADMIN_EMAIL=kevin@akcapital.fund

# Optional: transactional email notifications (subscription alerts to you +
# confirmations to investors) via https://resend.com — free tier is fine.
# Without it, only Supabase's auth emails (invites/resets) are sent.
RESEND_API_KEY=
EMAIL_FROM="3331 Trumbull Portal <onboarding@resend.dev>"
